# === Server (LAN / mobile app) ===
# Bind 0.0.0.0 so devices on the same Wi-Fi can reach the API (not only localhost)
HOST=0.0.0.0
PORT=8080

# === Database (MySQL) ===
# Option 1: Individual components (recommended for Docker/K8s)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bookify
DB_USER=root
DB_PASSWORD=

# Option 2: Or use complete DSN (uncomment to override DB_HOST/PORT/NAME/USER/PASSWORD)
# DATABASE_URL=root:password@tcp(127.0.0.1:3306)/bookify?parseTime=true&charset=utf8mb4

# === JWT ===
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=168h

# === File Upload ===
UPLOADS_DIR=./uploads
# Use your PC's LAN IP (ipconfig / ifconfig), NOT localhost — required for uploads on mobile
BASE_URL=http://192.168.1.100:8080

# === CORS ===
ALLOWED_ORIGINS=*

# === Default Superadmin ===
SUPERADMIN_EMAIL=superadmin@bookify.local
SUPERADMIN_PASSWORD=change-this-immediately-in-production

# === Default Admin (approve bookings, manage rooms) ===
ADMIN_EMAIL=admin@bookify.local
ADMIN_PASSWORD=change-this-immediately-in-production
ADMIN_NAME=Admin PLN

# === Petugas Booking (role: booking) ===
BOOKING_EMAIL=booking@bookify.local
BOOKING_PASSWORD=change-this-immediately-in-production
BOOKING_NAME=Petugas Booking PLN

# === Additional superadmin ===
SUPERADMIN2_EMAIL=superadmin.pln@bookify.local
SUPERADMIN2_PASSWORD=change-this-immediately-in-production
SUPERADMIN2_NAME=Super Admin PLN
